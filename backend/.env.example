# Django settings
DEBUG=True
SECRET_KEY=change-me-for-local-development
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database settings
DB_NAME=vintage_books
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Media and static files
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# JWT settings
ACCESS_TOKEN_LIFETIME=12
REFRESH_TOKEN_LIFETIME=12

# Browser access
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# PayPal sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# MinIO-backed object storage for local development
OBJECT_STORAGE_ENABLED=True
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=vintage-books-media
MINIO_REGION_NAME=us-east-1
MINIO_USE_SSL=False
MINIO_VERIFY_SSL=False
MINIO_ADDRESSING_STYLE=path
MINIO_PRESIGNED_URL_EXPIRY=3600
MINIO_BOOTSTRAP_RETRIES=12
MINIO_BOOTSTRAP_DELAY=2
